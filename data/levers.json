{
 "about": "Lever recipes (app/LeverZones.hpp): a throttle lever with gates, ready to apply. {n} is the engine of the lever. 'at_gate' places a stage at that fraction of the max gate of the calibrated lever; 'at' is a fraction of the used range (0 = idle, 1 = top). Your own recipes are saved in my_levers.json in the settings folder.",
 "recipes": [
  {
   "id": "airbus-inibuilds-reverse",
   "title": "Airbus (iniBuilds), reverse in the cut-off",
   "checked": "Checked on the A320neo V2, MSFS 2024 (2026-11-06)",
   "verified": true,
   "aircraft": ["microsoft-a320neo"],
   "press": [{"kind": "sim_event", "name": "THROTTLE{n}_AXIS_SET_EX1", "value": 0}],
   "integer": true,
   "lever": {
    "top": "full", "out_cutoff": -8192, "out_idle": -8192, "out_mil": 16384,
    "stages": [
     {"name": "CL", "at_gate": 0.55, "value": 0, "band": 0.05},
     {"name": "FLX/MCT", "at_gate": 1.0, "value": 8192, "band": 0.03},
     {"name": "TOGA", "at": 1.0, "value": 16384, "band": 0.03}
    ]
   },
   "cutoff": {
    "mode": "reverse",
    "toggle_event": "THROTTLE_REVERSE_THRUST_TOGGLE",
    "reversed": "(L:INI_AUTOTHRUST_TLA:{n}, Number) -1 <",
    "amount": 16384,
    "idle": -8192,
    "ground_only": true,
    "shared": true
   }
  },
